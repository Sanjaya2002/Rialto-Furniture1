# Copy to .env.local and fill in. Never commit real values.

# --- Database (Supabase Postgres, used by Prisma) ---
DATABASE_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase Auth / Storage ---
NEXT_PUBLIC_SUPABASE_URL="https://<project>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""            # server only: admin signup + custom-order attachments
SUPABASE_ATTACHMENTS_BUCKET="custom-order-attachments"   # optional, private bucket name

# --- Admin ---
ADMIN_SECRET_KEY=""                     # required to create admin accounts at /admin/signup

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://www.rialtofurniture.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="+94771234567"

# --- WhatsApp Cloud API (optional: notifies the shop of new quotations) ---
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ADMIN_PHONE_NUMBER=""
